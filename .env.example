# Docker images. Keep Elasticsearch and Kibana on exactly the same version.
STACK_VERSION=8.16.6

# Login used in Kibana and by the BBOT elastic output module.
BBOT_USERNAME=bbot
BBOT_PASSWORD=bbotbbot

# Internal service credentials. Change these on any non-local deployment.
ELASTIC_PASSWORD=change-me-elastic-admin
KIBANA_SYSTEM_PASSWORD=change-me-kibana-system

# At least 32 characters each. Generate new random values for production.
KIBANA_ENCRYPTION_KEY=change-me-32-characters-security1
KIBANA_SAVED_OBJECTS_KEY=change-me-32-characters-objects01
KIBANA_REPORTING_KEY=change-me-32-characters-report01

# Published ports and JVM heap.
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
ES_JAVA_OPTS=-Xms1g -Xmx1g

